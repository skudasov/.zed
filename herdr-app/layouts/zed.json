{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "background": "canvas",
  "terminal_padding": [
    10,
    8
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 220
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "zed-chrome"
          }
        },
        {
          "id": "spaces",
          "type": "block",
          "content": {
            "mod": "zed-spaces"
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "ask-name",
          "type": "block",
          "size": {
            "px": 0
          },
          "content": {
            "mod": "ask-name"
          }
        },
        {
          "id": "tabs",
          "type": "block",
          "size": {
            "px": 38
          },
          "window_drag": true,
          "content": {
            "mod": "tabs"
          }
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 1,
                  "radius": 0,
                  "background": "background",
                  "lone": false,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "selected"
                  },
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "height": 26,
                    "position": "top",
                    "reveal": "hover"
                  }
                }
              }
            }
          ]
        },
        {
          "id": "schedule",
          "type": "block",
          "size": {
            "px": 28
          },
          "content": {
            "mod": "schedule"
          },
          "hidden": true
        }
      ]
    }
  ]
}
