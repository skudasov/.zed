{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system"
  },
  "animations": false,
  "session": {
    "thinking": "hide",
    "verbosity": "low",
    "grouping": "auto",
    "sidebar": "hide",
    "tps": false
  },
  "tabs": {
    "mode": "off"
  },
  "keybinds": {
    "prompt.editor": "ctrl+g",
    "session.first": "home,alt+home"
  },
  "plugins": ["./plugins/minimal-footer"]
}
