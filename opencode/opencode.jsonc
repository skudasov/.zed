{
  "$schema": "https://opencode.ai/config.json",
  // Source of truth lives in ~/.config/zed/opencode/opencode.jsonc.
  // `just harness-configs` fills in the __PLACEHOLDER__ tokens for this
  // machine and copies the result to ~/.config/opencode/opencode.jsonc.
  // ponytail is pinned by `ponytail_version` in the Justfile, shared with claude.
  "plugin": ["@dietrichgebert/ponytail@__PONYTAIL_VERSION__"]
}
