# Ghostty config — source of truth lives here in ~/.config/zed/ghostty/config
# Install: `just install-configs` from ~/.config/zed (copies, does not symlink)
# Edits made directly in ~/.config/ghostty/config are overwritten on install.

# ── Theme ────────────────────────────────────────────────────────────────────
# Matches Zed: dark = "GitHub Dark Dimmed", light = "One Light"
# Custom theme files live in ~/.config/ghostty/themes/ (symlinked from repo)
theme = Breeze
background = #303135

# ── Font ─────────────────────────────────────────────────────────────────────
# Zed uses .ZedMono (bundled). Use any monospace you have installed.
# Uncomment and change to your preferred font:
# font-family = "ZedMono Nerd Font"
# font-family = "JetBrains Mono"
font-size = 15

# Ligatures — mirrors Zed terminal font_features
font-feature = +liga
font-feature = +ss02
font-feature = +ss03
font-feature = +ss05
font-feature = +ss07

# ── Cursor ───────────────────────────────────────────────────────────────────
cursor-style = block
cursor-style-blink = false

# ── Window ───────────────────────────────────────────────────────────────────
window-padding-x = 8
window-padding-y = 8
window-save-state = always

# ── Scrollback ───────────────────────────────────────────────────────────────
scrollback-limit = 30000

# ── Shell ────────────────────────────────────────────────────────────────────
# shell-integration = fish   # uncomment if using fish

# ── Keybinds ─────────────────────────────────────────────────────────────────
# Forward cmd+z/x/c/j/k/l (and shift variants) to terminal apps as kitty-protocol
# key sequences so herdr can bind them. Overrides Ghostty undo/redo/copy.
# Each one needs a matching binding in herdr/config.toml [keys], else the bytes
# fall through into the focused pane. Current mapping:
#   cmd+z / cmd+shift+z -> next/previous workspace
#   cmd+x / cmd+shift+x -> next/previous tab
#   cmd+j -> new workspace   cmd+k -> new tab   cmd+l -> horizontal split
#   cmd+1 -> toggle sidebar (spaces + agents)
#   cmd+e -> quick actions (agent layouts, reviews)
#   cmd+c -> unbound in herdr
# Note: cmd+1 overrides Ghostty's default "jump to tab 1".
keybind = super+digit_1=text:\x1b[49;9u
keybind = super+1=text:\x1b[49;9u
keybind = super+z=text:\x1b[122;9u
keybind = super+shift+z=text:\x1b[122;10u
keybind = super+x=text:\x1b[120;9u
keybind = super+shift+x=text:\x1b[120;10u
keybind = super+c=text:\x1b[99;9u
keybind = super+e=text:\x1b[101;9u
keybind = super+j=text:\x1b[106;9u
keybind = super+k=text:\x1b[107;9u
keybind = super+l=text:\x1b[108;9u
