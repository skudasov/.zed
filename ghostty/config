# Ghostty config — sourced from ~/.config/zed/ghostty/config
# Install: `just install-ghostty` from ~/.config/zed

# ── Theme ────────────────────────────────────────────────────────────────────
# Matches Zed: dark = "GitHub Dark Dimmed", light = "One Light"
# Custom theme files live in ~/.config/ghostty/themes/ (symlinked from repo)
theme = Breeze

# ── Font ─────────────────────────────────────────────────────────────────────
# Zed uses .ZedMono (bundled). Use any monospace you have installed.
# Uncomment and change to your preferred font:
# font-family = "ZedMono Nerd Font"
# font-family = "JetBrains Mono"
font-size = 15

# Ligatures — mirrors Zed terminal font_features
font-feature = +liga
font-feature = +ss02
font-feature = +ss03
font-feature = +ss05
font-feature = +ss07

# ── Cursor ───────────────────────────────────────────────────────────────────
cursor-style = block
cursor-style-blink = false

# ── Window ───────────────────────────────────────────────────────────────────
window-padding-x = 8
window-padding-y = 8
window-save-state = always

# ── Scrollback ───────────────────────────────────────────────────────────────
scrollback-limit = 30000

# ── Shell ────────────────────────────────────────────────────────────────────
# shell-integration = fish   # uncomment if using fish

# ── Keybinds ─────────────────────────────────────────────────────────────────
# Forward cmd+z/x (and shift variants) to terminal apps as kitty-protocol
# key sequences so herdr can bind them. Overrides Ghostty undo/redo.
keybind = super+z=text:\x1b[122;9u
keybind = super+shift+z=text:\x1b[122;10u
keybind = super+x=text:\x1b[120;9u
keybind = super+shift+x=text:\x1b[120;10u
