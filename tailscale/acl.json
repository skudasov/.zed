// OPTIONAL. You normally do NOT need this file.
//
// A new tailnet's DEFAULT policy already lets you SSH to your own devices,
// so `just tailscale-host` (which runs `tailscale up --ssh`) works with no
// edits and no tags. Use this file only if you previously customized your
// tailnet policy and removed the default self-SSH rule.
//
// Apply it hands-free with:
//   TS_API_KEY=tskey-api-... just tailscale-acl-push
// (key from https://login.tailscale.com/admin/settings/keys)
//
// No tags -> no `requested tags ... invalid or not permitted` errors.
{
  // Members of your tailnet may reach their OWN devices on TCP 22 only.
  "acls": [
    {
      "action": "accept",
      "src": ["autogroup:member"],
      "dst": ["autogroup:self:22"]
    }
  ],

  // Tailscale SSH into your own devices as the non-root login user.
  // `check` forces periodic re-auth; use "accept" to skip it.
  "ssh": [
    {
      "action": "check",
      "src": ["autogroup:member"],
      "dst": ["autogroup:self"],
      "users": ["autogroup:nonroot"]
    }
  ]
}
